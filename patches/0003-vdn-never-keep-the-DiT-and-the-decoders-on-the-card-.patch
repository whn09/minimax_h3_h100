 src/inference/infer_ulysses.py | 32 ++++++++++++++++++++++++++++----
 src/inference/render.py        | 18 ++++++++++++++++--
 3 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/src/config/inference.py b/src/config/inference.py
index 7d56c95..b818e96 100644
--- a/src/config/inference.py
+++ b/src/config/inference.py
@@ -57,6 +57,12 @@ class ParallelConfig:
     """torchrun layout for infer_ulysses.py."""
     softmax_ranks: int = 6               # 0 = standard Ulysses; n = n softmax + (world-n) linear
     profile: bool = False                # per-section CUDA events: profiling only
+    # Park the DiT on the host after denoising, so the main rank can hold the decoders and
+    # a full-length decode. Needed at 768p on an 80 GiB card and nowhere else: 45.2 GiB of
+    # fp8 weights, plus ~11 GiB of decoders, plus a 345-frame 1344x768 decode is ~4 GiB
+    # over. Costs ~27 s of PCIe, all of it after the measured denoise -- so leave it off
+    # when the canvas has headroom, which 480p does.
+    offload_transformer_before_decode: bool = False
 
 
 @dataclass
diff --git a/src/inference/infer_ulysses.py b/src/inference/infer_ulysses.py
index 7a14b0d..9778549 100644
--- a/src/inference/infer_ulysses.py
+++ b/src/inference/infer_ulysses.py
@@ -36,7 +36,7 @@ from src.inference.utils.assemble import (
     write_json,
 )
 from src.inference.render import (decode_and_save, generate_latents, latent_grid,
-                                  load_prompt)
+                                  load_decoders_only, load_prompt)
 from src.inference.utils.ulysses import init_ulysses, install_ulysses
 
 
@@ -57,9 +57,13 @@ def main():
     device = runtime.device
     torch.set_grad_enabled(False)
 
-    model = build_inference_model(
-        cfg, device, load_decoders=runtime.is_main, log=runtime.is_main
-    )
+    # No rank loads decoders here, not even the main one. On an 80 GiB card the DiT and the
+    # VAEs cannot be co-resident at 768p, and they never need to be: the decoders are idle
+    # during denoising and the transformer is idle during decoding. So the decoders arrive
+    # after the loop (below) and the transformer leaves before the decode. Without this,
+    # rank 0 dies in a block's activations while ranks 1-7 finish, because rank 0 is the
+    # only rank that carries decoders. Both moves are timed separately so nothing hides.
+    model = build_inference_model(cfg, device, load_decoders=False, log=runtime.is_main)
     if not model.is_hybrid:
         raise ValueError("Ulysses path currently requires a HybridAttention checkpoint")
 
@@ -137,6 +141,24 @@ def main():
         os.makedirs(os.path.dirname(lpath) or ".", exist_ok=True)
         torch.save({"video": latents.cpu(), "audio": audio_latents.cpu()}, lpath)
 
+    # ... and the transformer goes the other way, when the config asks. At 768p on an
+    # 80 GiB card the DiT (45.2 GiB in fp8) and the decoders (~11 GiB) plus a 345-frame
+    # 1344x768 decode do not fit together either -- the decode wants ~4 GiB more than what
+    # is left. Denoising is finished, so the main rank parks the transformer on the host
+    # first. Every other rank is already waiting at the barrier below and holds nothing that
+    # matters. Off by default: it is ~27 s of PCIe, and 480p does not need it.
+    offload_started = time.perf_counter()
+    if runtime.is_main and cfg.parallel.offload_transformer_before_decode:
+        model.transformer.to("cpu")
+        torch.cuda.empty_cache()
+    timings["transformer_offload_seconds"] = time.perf_counter() - offload_started
+
+    # The denoising activations are gone by now, so the decoders have room.
+    decoder_load_started = time.perf_counter()
+    if runtime.is_main:
+        model.vae, model.audio_vae = load_decoders_only(cfg.vae_source, str(device))
+    timings["decoder_load_seconds"] = time.perf_counter() - decoder_load_started
+
     decode_started = time.perf_counter()
     if runtime.is_main:
         decode_and_save(
@@ -174,6 +196,8 @@ def main():
             f"denoise {timings['denoise_seconds']:.2f}s "
             f"({timings['seconds_per_step']:.2f}s/step; per NFE "
             + " ".join(f"{x:.2f}" for x in timings["step_seconds"]) + "), "
+            f"offload {timings['transformer_offload_seconds']:.2f}s, "
+            f"decoder load {timings['decoder_load_seconds']:.2f}s, "
             f"decode+encode {timings['decode_and_encode_seconds']:.2f}s, "
             f"E2E {timings['end_to_end_seconds']:.2f}s",
             flush=True,
