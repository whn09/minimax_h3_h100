diff --git a/src/inference/utils/parallel_vae.py b/src/inference/utils/parallel_vae.py
new file mode 100644
index 0000000..707fee5
--- /dev/null
+++ b/src/inference/utils/parallel_vae.py
@@ -0,0 +1,167 @@
+"""Data-parallel video VAE decode across the Ulysses ranks.
+
+The decode is the bigger half of a 480p render's post-warmup latency -- 13.8 s against
+8.9 s of denoising -- and upstream runs all of it on rank 0 while the other seven ranks
+sit at the barrier. It does not have to be that way, and the reason is the shape of
+`AutoencoderKLMiniMaxH3._decode`:
+
+  * the decoder is a **non-causal ViT** (36 layers, 32 x 64 heads). Only the *encoder* is
+    a causal 3D CNN, so there is no conv cache threaded from one temporal chunk to the
+    next -- `_decode_clip(z[:, :, start : start + tokens_chunk_size + token_overlap])` is
+    a pure function of its 7-latent-frame slice;
+  * inside a clip, tiling makes each 256x256 pixel tile another independent forward;
+  * the only coupling is linear: `_blend` cross-fades the tile edges and the 5-frame
+    chunk overlaps, in pixel space, after every forward has finished.
+
+So it is a grid of independent forwards, which makes this **data** parallelism, not
+tensor parallelism. TP would shard a 2048-wide ViT and pay an all-reduce inside every one
+of the 300 tiles; DP pays one all-gather for the whole decode. At 345 frames the grid is
+20 temporal chunks x 15 tiles = 300 decoder calls at 480p (28 tiles, 560 calls at 768p),
+and the measured 768p/480p decode ratio, 1.82x, matches the 1.87x call ratio -- so call
+count is what this costs, and splitting the calls is what fixes it.
+
+Chunks are the unit here rather than (chunk, tile) pairs: 20 chunks over 8 ranks is a
+ceiling of 20/3 = 6.67x against 300/38 = 7.89x for pairs, but pairs have to ship the
+overlapping tiles instead of the stitched frames -- 2.37x the pixels at 480p -- for a
+fifth of a second. Chunks also keep `_decode_clip` intact, so the tile stitching is
+upstream's own code and cannot drift from it.
+
+The output is bit-identical to `vae.decode(z)`: the same slices go through the same
+`_decode_clip`, and the blend chain on rank 0 is `_decode`'s, in the same order.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.distributed as dist
+
+# Index <-> dtype, so the decoder's output dtype can travel through a one-element int64
+# broadcast. Order is load-bearing: it is the wire format, so only ever append.
+_DTYPES = (torch.float16, torch.bfloat16, torch.float32, torch.float64)
+
+
+def can_decode_in_parallel(vae) -> bool:
+    """Whether this VAE's decode has the chunk structure below. The released checkpoint
+    does (clip_length 17, token_drop 3); a config without a token drop has no chunk
+    overlap and would need a different assembly, so it falls back to vae.decode."""
+    return getattr(vae, "tokens_chunk_size", 0) > 0 and vae.config.token_drop > 0
+
+
+@torch.no_grad()
+def decode_video_parallel(vae, z: torch.Tensor, runtime) -> torch.Tensor:
+    """`vae.decode(z, return_dict=False)[0]`, with the temporal chunks spread over
+    runtime's ranks. Every rank must call this -- there is an all-gather inside. Only the
+    return value on rank 0 is the full video; the others get their own partial buffer,
+    which the caller ignores.
+
+    Mirrors AutoencoderKLMiniMaxH3._decode step for step; see the module docstring for
+    why that is safe to do.
+    """
+    tokens_chunk = vae.tokens_chunk_size
+    token_drop = vae.config.token_drop
+    temporal_ratio = vae.temporal_compression_ratio
+    chunk_num_frames = tokens_chunk * temporal_ratio
+
+    # _decode's padding and chunk count, unchanged.
+    num_tokens = z.shape[2] + token_drop
+    pad_tokens = (-num_tokens) % tokens_chunk
+    num_chunks = (num_tokens + pad_tokens) // tokens_chunk - int(token_drop > 0)
+    if pad_tokens > 0:
+        z = torch.cat([z, z[:, :, -1:].repeat(1, 1, pad_tokens, 1, 1)], dim=2)
+
+    world_size, rank = runtime.world_size, runtime.rank
+    # Chunk c -> rank c % world_size, slot c // world_size. Round-robin rather than
+    # contiguous so that the ranks that get the extra chunk are spread over the node; with
+    # 20 chunks and 8 ranks four ranks do 3 and four do 2, and the decode takes 3.
+    chunks_per_rank = -(-num_chunks // world_size)
+    my_chunks = [c for c in range(num_chunks) if c % world_size == rank]
+
+    # Every chunk yields the same two pieces: `chunk_num_frames - frame_pre_padding`
+    # frames that go into the video, and (when token_drop > 0) `frame_overlap` frames that
+    # cross-fade into the next chunk. Concatenating them makes the gather one uniform
+    # tensor instead of two.
+    # Worked through on the released config, because the two pieces are NOT the same size
+    # and assuming they were would corrupt the gather. clip_length 17, token_drop 3 ->
+    # tokens_chunk_size 5, token_overlap 2, frame_pre_padding 3, frame_overlap 5,
+    # temporal_ratio 4, so chunk_num_frames = 20 and _decode_clip is fed 5 + 2 = 7 latent
+    # frames = 28 pixel frames. j=0 takes clip[0:20][3:] = 17 frames; j=1 takes
+    # clip[20:28][3:] = 5 = frame_overlap. 20 chunks x 17 + a trailing 5 = 345 frames, which
+    # is the requested clip length exactly.
+    main_frames = chunk_num_frames - vae.frame_pre_padding
+    overlap_frames = vae.frame_overlap
+    piece_frames = main_frames + (overlap_frames if token_drop > 0 else 0)
+
+    height = z.shape[-2] * vae.spatial_compression_ratio
+    width = z.shape[-1] * vae.spatial_compression_ratio
+
+    local = None
+    for c in my_chunks:
+        start = c * tokens_chunk
+        clip = vae._decode_clip(z[:, :, start : start + tokens_chunk + vae.token_overlap])
+        pieces = []
+        for j in range(int(token_drop > 0) + 1):
+            frame_start = j * chunk_num_frames
+            piece = clip[:, :, frame_start : frame_start + chunk_num_frames]
+            pieces.append(piece[:, :, vae.frame_pre_padding :])
+        piece = torch.cat(pieces, dim=2)
+        if local is None:
+            # Allocated from the first real tile so the dtype and layout are the
+            # decoder's own (fp16 under the caller's autocast), never guessed.
+            local = piece.new_zeros((chunks_per_rank, piece.shape[1], piece_frames, height, width))
+        local[c // world_size] = piece[0]
+
+    # An all-gather requires every rank to agree on the buffer's dtype, and a rank that got
+    # no chunks has nothing to read it off. The decoder's parameter dtype is the wrong
+    # answer -- the caller wraps this in autocast(float16), so the pieces come back fp16
+    # while the parameters are fp32 -- and guessing it would be a silent corruption rather
+    # than an error. So rank 0 says: it holds chunk 0 whenever there is a chunk at all, by
+    # the round-robin above. Eight bytes, once per decode.
+    code = torch.zeros(1, dtype=torch.int64, device=z.device)
+    if local is not None:
+        code[0] = _DTYPES.index(local.dtype)
+    dist.broadcast(code, src=0)
+    dtype = _DTYPES[int(code.item())]
+
+    if local is None:
+        # Fewer chunks than ranks (a short clip). This rank still has to join the
+        # all-gather, so it contributes zeros -- rank 0 never reads those slots.
+        local = torch.zeros((chunks_per_rank, vae.config.out_channels, piece_frames, height, width),
+                            device=z.device, dtype=dtype)
+    elif local.dtype is not dtype:
+        raise RuntimeError(f"rank {rank} decoded {local.dtype} but rank 0 decoded {dtype}; "
+                           f"the gather would silently reinterpret the bytes")
+
+    gathered = torch.empty((world_size * chunks_per_rank, *local.shape[1:]),
+                           device=local.device, dtype=local.dtype)
+    dist.all_gather_into_tensor(gathered, local.contiguous())
+
+    if not runtime.is_main:
+        return gathered
+
+    # _decode's assembly, over the gathered pieces instead of locally computed ones.
+    decoded_chunks = []
+    overlap = None
+    for c in range(num_chunks):
+        piece = gathered[(c % world_size) * chunks_per_rank + c // world_size].unsqueeze(0)
+        chunk = piece[:, :, :main_frames]
+        if overlap is not None:
+            chunk = vae._blend(overlap, chunk, vae.frame_overlap, dim=-3)
+        decoded_chunks.append(chunk)
+        if token_drop > 0:
+            overlap = piece[:, :, main_frames:]
+    if overlap is not None:
+        decoded_chunks.append(overlap)
+
+    dec = torch.cat(decoded_chunks, dim=2)
+
+    # And _decode's trailing trim for the repeated latent frames.
+    if pad_tokens > 0:
+        intra_tail = vae.config.clip_length % temporal_ratio
+        num_tokens_before_pad = z.shape[2] - pad_tokens
+        pad_frames = sum(
+            intra_tail if intra_tail and (num_tokens_before_pad + k) % tokens_chunk == 0
+            else temporal_ratio
+            for k in range(pad_tokens)
+        )
+        dec = dec[:, :, :-pad_frames]
+    return dec
