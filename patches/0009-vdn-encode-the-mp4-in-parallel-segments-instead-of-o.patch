+def _write_frames(stream, container, y_np, u_np, v_np) -> None:
+    """Feed a (frames, h, w) plane triple into `stream`, muxing into `container`."""
+    import av
+    import numpy as np
+
+    height, width = y_np.shape[1:]
+    for index in range(y_np.shape[0]):
+        frame = av.VideoFrame(width, height, "yuv420p")
+        # PyAV exposes each plane as a writable buffer with its own stride, which is padded up
+        # for alignment and is NOT width. Going through np.frombuffer on the plane and slicing
+        # to the real width is what respects that; `plane.update(bytes)` would need the
+        # padding baked into the source.
+        for plane, source in zip(frame.planes, (y_np[index], u_np[index], v_np[index])):
+            view = np.frombuffer(plane, dtype=np.uint8).reshape(-1, plane.line_size)
+            view[: source.shape[0], : source.shape[1]] = source
+        frame.pts = index
+        for packet in stream.encode(frame):
+            container.mux(packet)
+    for packet in stream.encode():
+        container.mux(packet)
+
+
+def _encode_segment(y_np, u_np, v_np, fps: int, thread_count: int) -> bytes:
+    """One contiguous frame range, encoded to an in-memory mp4. Runs in a worker thread.
+
+    In memory rather than in a temp file: a segment is a few hundred KB, and BytesIO is
+    seekable, which is all the mp4 muxer needs to write its moov atom.
+    """
+    import io
+
+    import av
+
+    buffer = io.BytesIO()
+    with av.open(buffer, mode="w", format="mp4") as container:
+        stream = container.add_stream("libx264", rate=int(fps))
+        stream.height, stream.width = y_np.shape[1:]
+        stream.pix_fmt = "yuv420p"
+        stream.codec_context.thread_count = thread_count
+        _write_frames(stream, container, y_np, u_np, v_np)
+    return buffer.getvalue()
+
+
+def _video_stream_from(blob: bytes, container, fps: int):
+    """Add an output video stream matching an encoded segment, without muxing anything.
+
+    Split out from the copy below because **every stream has to exist before the first
+    packet is muxed**: PyAV writes the container header on the first `mux()`, and a stream
+    added after that gets no time base, which surfaces later as `ValueError: Cannot rebase
+    to zero time` when the audio is written. The template can only be read off an encoded
+    segment, so the order is: encode the segments, add the video stream, add the audio
+    stream, and only then copy the packets.
+    """
+    import io
+
+    import av
+
+    with av.open(io.BytesIO(blob)) as segment:
+        source = segment.streams.video[0]
+        stream = container.add_stream_from_template(source)
+        # The template's time base comes along, and it is deliberately left alone: the mp4
+        # muxer overwrites whatever is set here when it writes the header (it went straight
+        # back to the template's 1/12288 when this tried to force 1/24), so the only reliable
+        # unit to re-stamp in is the one the output actually ends up with. Which the copy
+        # below reads off the stream rather than assuming.
+        return stream, source.codec_context.extradata
+
+
+def _copy_segments(blobs, container, stream, extradata, fps: int) -> None:
+    """Bitstream-copy encoded segments into `stream`, re-stamping the timestamps.
+
+    Concatenating H.264 like this is sound because each segment was encoded independently:
+    it opens with an IDR and no frame in it references anything outside it, so a decoder can
+    start there. The one thing that must hold across segments is the SPS/PPS, since mp4
+    carries a single copy in the `avcC` box -- identical dimensions and identical encoder
+    settings give identical parameter sets, and that is asserted rather than assumed.
+
+    Every segment's timestamps restart at 0, so each one is shifted by the frames already
+    written. The shift is in the OUTPUT stream's own time base, read off the stream: mp4
+    writes 1/12288 here, so a frame at 24 fps is 512 ticks. Doing the arithmetic in frame
+    indices instead and letting PyAV rescale looked cleaner and was wrong twice over -- with
+    `packet.time_base` left alone the indices were read as 1/12288 ticks (a 4952 fps clip),
+    and with it set to 1/fps the pts came out right but `packet.duration`, which is already in
+    the segment's units, was rescaled a second time and the mp4's frame-rate header went to
+    9.67 fps. scripts/clipinfo.py is what catches this: the frames and their order survive
+    both bugs, so a frame count or a PSNR sees nothing wrong.
+    """
+    import io
+
+    import av
+
+    time_base = stream.time_base
+    ticks_per_frame = int(round(1 / (int(fps) * time_base)))
+    offset = 0
+    for blob in blobs:
+        with av.open(io.BytesIO(blob)) as segment:
+            source = segment.streams.video[0]
+            if source.codec_context.extradata != extradata:
+                raise RuntimeError("segments disagree on SPS/PPS; the concatenation would "
+                                   "decode as garbage after the first segment")
+            scale = source.time_base / time_base       # 1 in practice; not assumed
+            frames = 0
+            for packet in segment.demux(source):
+                if packet.dts is None:
+                    continue                      # the demuxer's flush packet
+                # pts and dts separately, because libx264 emits B-frames and the two orders
+                # differ; dts can also start negative, which the offset absorbs.
+                packet.pts = offset + round(packet.pts * scale)
+                packet.dts = offset + round(packet.dts * scale)
+                if packet.duration:
+                    packet.duration = round(packet.duration * scale)
+                packet.stream = stream
+                container.mux(packet)
+                frames += 1
+            offset += frames * ticks_per_frame
+
+
