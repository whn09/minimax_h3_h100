+def print_repeat_summary(requests: list[dict], world_size: int) -> None:
+    """The distribution over a `render.repeat` run, and the two things it is there to answer.
+
+    Steady state is taken over requests 2.., never over all of them: request 1 pays the
+    decoder load, so averaging it in would report a latency that only the first request of a
+    process ever sees. With a single steady request there is no spread to report and the table
+    is the whole answer, which is stated rather than printed as a std of 0.
+    """
+    def get(row, key):
+        return row.get(key, 0.0) or 0.0
+
+    print(f"\nrepeat: {len(requests)} requests in one process "
+          f"(DiT {requests[0]['transformer_release_mode']})", flush=True)
+    header = (f"{'req':>4} {'denoise':>9} {f'vae x{world_size}':>9} {'dec+enc':>9} "
+              f"{'dload':>7} {'total':>8} {'alloc_end':>10} {'resv_end':>9}")
+    print(header, flush=True)
+    for i, row in enumerate(requests):
+        print(f"{i + 1:>4} {get(row, 'denoise_seconds'):9.2f} "
+              f"{get(row, 'parallel_video_vae_seconds'):9.2f} "
+              f"{get(row, 'decode_and_encode_seconds'):9.2f} "
+              f"{get(row, 'decoder_load_seconds'):7.2f} "
+              f"{get(row, 'request_seconds'):8.2f} "
+              f"{get(row, 'allocated_after_request_gib'):10.1f} "
+              f"{get(row, 'reserved_after_request_gib'):9.1f}", flush=True)
+
+    steady = requests[1:]
+    if not steady:
+        return
+    for label, key in (("request total", "request_seconds"),
+                       ("denoise", "denoise_seconds"),
+                       (f"video vae x{world_size}", "parallel_video_vae_seconds"),
+                       ("decode+encode", "decode_and_encode_seconds"),
+                       # Zero unless parallel.vae_after_decode is "free", in which case these
+                       # two ARE the price of the DiT staying resident and belong in the table.
+                       ("decoder load", "decoder_load_seconds"),
+                       ("vae release", "vae_release_seconds")):
+        xs = [get(row, key) for row in steady]
+        mean = sum(xs) / len(xs)
+        spread = (sum((x - mean) ** 2 for x in xs) / (len(xs) - 1)) ** 0.5 if len(xs) > 1 else 0.0
+        print(f"steady (requests 2-{len(requests)}) {label:>22}: "
+              f"mean {mean:6.2f}s  sd {spread:5.3f}  min {min(xs):6.2f}  max {max(xs):6.2f}",
+              flush=True)
+
+    # The leak check, said out loud rather than left for the reader to diff two columns.
+    growth = (get(steady[-1], "reserved_after_request_gib")
+              - get(steady[0], "reserved_after_request_gib"))
+    print(f"reserved after request {len(requests)} minus after request 2: {growth:+.3f} GiB",
+          flush=True)
+
+
