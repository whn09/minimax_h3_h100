diff --git a/src/inference/utils/yuv.py b/src/inference/utils/yuv.py
new file mode 100644
index 0000000..5fdd0f7
--- /dev/null
+++ b/src/inference/utils/yuv.py
@@ -0,0 +1,159 @@
+"""Do the RGB -> YUV420p colour conversion on the GPU, not in swscale.
+
+After the video VAE went data-parallel (utils/parallel_vae.py) the largest single item left
+in a 480p request was the mp4 mux, at 2.65 s against the eight-way decode's 2.11 s. Measured
+with scripts/mux_bench.py, on 345 frames of 864x480, that 2.65 s decomposes as:
+
+    VideoFrame.from_ndarray(rgb24)      0.30 s
+    reformat rgb24 -> yuv420p           2.03 s   <-- swscale, single-threaded
+    x264 encode, thread_count=0         1.72 s   (already multi-threaded; 6.40 s at 1)
+
+So it was never x264. It is the colour conversion, running serially in the calling thread,
+which is why setting `thread_count` on the stream buys almost nothing (1.17x). The pixels
+are already on the GPU as float32 in [0, 1] -- the conversion is a 3x3 matrix and a 2x2
+average, both of which the card does in microseconds.
+
+Converting here also halves the host transfer, which is the second item on the list:
+yuv420p is 1.5 bytes per pixel against rgb24's 3, so a 345-frame 864x480 clip crosses PCIe
+as 215 MB instead of 430 MB.
+
+**This changes the encoded bytes.** It is a reimplementation of a lossy conversion, not a
+refactor of one, so it is behind a config switch and validated numerically rather than
+assumed: scripts/mux_bench.py --verify reports the PSNR against swscale's own output on real
+frames, and anything below ~50 dB means the matrix or the range is wrong.
+"""
+
+from __future__ import annotations
+
+import torch
+
+# BT.601, limited ("TV") range -- Y in [16, 235], Cb/Cr in [16, 240] about 128. This is what
+# swscale produces for an rgb24 -> yuv420p conversion when nothing sets a colorspace or a
+# range, which is the case in diffusers' encode_video: it sets width, height and pix_fmt and
+# nothing else. Matching the default is the point; picking BT.709 here because the clip is
+# "HD" would silently shift every colour in the output relative to every previously rendered
+# clip.
+#
+# Coefficients are the ITU-R BT.601 ones scaled for a [0, 1] input and a [0, 255] output:
+#   Y  =  16 + (  65.481 R + 128.553 G +  24.966 B )
+#   Cb = 128 + ( -37.797 R -  74.203 G + 112.000 B )
+#   Cr = 128 + ( 112.000 R -  93.786 G -  18.214 B )
+_Y_COEFF = (65.481, 128.553, 24.966)
+_CB_COEFF = (-37.797, -74.203, 112.000)
+_CR_COEFF = (112.000, -93.786, -18.214)
+
+
+@torch.no_grad()
+def rgb_to_yuv420p(video: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """`video` is (frames, 3, height, width) float in [0, 1], on any device.
+
+    Returns `(y, u, v)` as uint8 on the same device: y is (frames, height, width) and u, v
+    are (frames, height // 2, width // 2).
+
+    Chroma is the 2x2 average. Averaging the chroma of four pixels and taking the chroma of
+    their average are the same thing here -- the transform is affine and the four weights are
+    equal -- so this pools the chroma planes rather than the RGB, which is one fewer pass.
+    """
+    if video.ndim != 4 or video.shape[1] != 3:
+        raise ValueError(f"expected (frames, 3, height, width), got {tuple(video.shape)}")
+    height, width = video.shape[-2:]
+    if height % 2 or width % 2:
+        # yuv420p has no way to represent a half chroma sample. Every canvas this renderer
+        # can produce is a multiple of 32 (the 16x VAE then the 2x2 patch), so this is a
+        # guard against a future caller, not a case to handle.
+        raise ValueError(f"yuv420p needs even dimensions, got {height}x{width}")
+
+    video = video.float().clamp_(0.0, 1.0)
+    r, g, b = video[:, 0], video[:, 1], video[:, 2]
+
+    def plane(coeff, offset):
+        cr, cg, cb = coeff
+        return (r * cr + g * cg + b * cb + offset).round_().clamp_(0, 255).to(torch.uint8)
+
+    y = plane(_Y_COEFF, 16.0)
+    # Compute chroma at full resolution in float, pool, and only then quantise -- pooling
+    # after the uint8 round would average four already-rounded values and lose up to half a
+    # level per sample for no gain.
+    cb = (r * _CB_COEFF[0] + g * _CB_COEFF[1] + b * _CB_COEFF[2] + 128.0)
+    cr = (r * _CR_COEFF[0] + g * _CR_COEFF[1] + b * _CR_COEFF[2] + 128.0)
+    u = _pool2(cb).round_().clamp_(0, 255).to(torch.uint8)
+    v = _pool2(cr).round_().clamp_(0, 255).to(torch.uint8)
+    return y, u, v
+
+
+def _pool2(plane: torch.Tensor) -> torch.Tensor:
+    """2x2 box average of a (frames, height, width) plane, without a conv."""
+    frames, height, width = plane.shape
+    return plane.view(frames, height // 2, 2, width // 2, 2).mean(dim=(2, 4))
+
+
+def encode_video_yuv420p(planes, fps: int, output_path: str, audio=None,
+                         audio_sample_rate: int | None = None) -> None:
+    """`diffusers.utils.export_utils.encode_video`, taking yuv420p planes instead of rgb24.
+
+    `planes` is the `(y, u, v)` from `rgb_to_yuv420p`, already on the host. Each frame's
+    planes are written straight into an `av.VideoFrame`'s buffers, so nothing in this function
+    converts a colour space -- which is the entire point, that work having already happened on
+    the card.
+
+    The audio path is diffusers' own, imported rather than reimplemented: the soundtrack is
+    a few hundred KB and none of it is on the critical path.
+    """
+    import av
+    import numpy as np
+    from diffusers.utils.export_utils import _prepare_audio_stream, _write_audio
+
+    y, u, v = planes
+    num_frames, height, width = y.shape
+
+    container = av.open(output_path, mode="w")
+    stream = container.add_stream("libx264", rate=int(fps))
+    stream.width, stream.height = width, height
+    stream.pix_fmt = "yuv420p"
+    # Measured worth 1.17x on its own (scripts/mux_bench.py): 0 is "decide for me", which for
+    # libx264 hands off to x264's own auto-detect. PyAV does not set this, and upstream's
+    # encode_video does not either. Small next to the conversion this file removes, but free.
+    stream.codec_context.thread_count = 0
+
+    audio_stream = None
+    if audio is not None:
+        if audio_sample_rate is None:
+            raise ValueError("audio_sample_rate is required when audio is provided")
+        audio_stream = _prepare_audio_stream(container, audio_sample_rate)
+
+    y_np, u_np, v_np = (p.numpy() for p in (y, u, v))
+    for index in range(num_frames):
+        frame = av.VideoFrame(width, height, "yuv420p")
+        # PyAV exposes each plane as a writable buffer with its own stride, which is padded up
+        # for alignment and is NOT width. Going through np.frombuffer on the plane and slicing
+        # to the real width is what respects that; `plane.update(bytes)` would need the
+        # padding baked into the source.
+        for plane, source in zip(frame.planes, (y_np[index], u_np[index], v_np[index])):
+            view = np.frombuffer(plane, dtype=np.uint8).reshape(-1, plane.line_size)
+            view[: source.shape[0], : source.shape[1]] = source
+        frame.pts = index
+        for packet in stream.encode(frame):
+            container.mux(packet)
+
+    for packet in stream.encode():
+        container.mux(packet)
+    if audio is not None:
+        _write_audio(container, audio_stream, audio, audio_sample_rate, av)
+    container.close()
+
+
+def to_host(*planes: torch.Tensor) -> tuple[torch.Tensor, ...]:
+    """Copy planes to the host through pinned staging buffers, all three in flight at once.
+
+    The default `.cpu()` lands in pageable memory, which the driver has to stage internally
+    one chunk at a time: measured on this box, 430 MB of rgb24 took 0.35 s, i.e. 1.9 GB/s
+    against the ~25 GB/s the link can do. Pinned destinations let the copies be real DMA and
+    lets all three planes overlap, so the whole transfer is one synchronise instead of three
+    blocking calls.
+    """
+    staged = [torch.empty(p.shape, dtype=p.dtype, pin_memory=True) for p in planes]
+    for host, device_plane in zip(staged, planes):
+        host.copy_(device_plane, non_blocking=True)
+    if planes and planes[0].is_cuda:
+        torch.cuda.current_stream(planes[0].device).synchronize()
+    return tuple(staged)
