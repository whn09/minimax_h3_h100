diff --git a/src/inference/render.py b/src/inference/render.py
index 10e08ca..308378f 100644
--- a/src/inference/render.py
+++ b/src/inference/render.py
@@ -27,6 +27,25 @@ from src.models.hybrid_transform import iter_hybrids, set_layout
 DEFAULT_MODEL_ROOT = H3_BASE
 # The production canvas, 768x1344, through the 16x spatial VAE.
 LATENT_H, LATENT_W = 48, 84
+# The VAE's spatial compression. Not read off vae.config here on purpose: the Ulysses
+# ranks that never decode are built with load_decoders=False, so the geometry has to be
+# derivable from the config alone, on every rank.
+VAE_SPATIAL = 16
+
+
+def latent_grid(height: int, width: int):
+    """Pixel canvas -> (latent_h, latent_w). Both must be a multiple of 2*VAE_SPATIAL:
+    the VAE takes 16x and the transformer then patchifies 2x2 (patch_size (1, 2, 2)),
+    so an odd latent extent would silently truncate a row of tokens. 480p is
+    864x480 -> 54x30 -> 27x15 patched tokens per frame; 768p is 1344x768 -> 84x48."""
+    step = 2 * VAE_SPATIAL
+    for name, value in (("height", height), ("width", width)):
+        if value <= 0 or value % step:
+            raise ValueError(f"render.{name}={value} must be a positive multiple of {step} "
+                             f"(the 16x VAE followed by the 2x2 transformer patch)")
+    return height // VAE_SPATIAL, width // VAE_SPATIAL
+
+
 # Mirrors of MiniMaxH3ModularPipeline.pixel_mean / pixel_std / keyframe_noise_aug: those
 # are properties of an assembled pipeline, which the inlined blocks below never build.
 # 0.999 is the t the fl2va keyframes are held at, just short of clean.
@@ -72,10 +91,14 @@ def load_prompt(prompt_file: str, device: str):
 @torch.no_grad()
 def generate_latents(transformer, prompt_embeds, text_token_tags, num_frames, num_steps, seed, device,
                      video_shift=12.0, audio_shift=3.0, runtime=None, step_seconds=None,
-                     conditions=None):
