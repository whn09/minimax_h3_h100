+@torch.no_grad()
+def decode_video_latents_yuv(vae, latents, device: str, runtime):
+    """The same decode as decode_video_latents, assembled straight into yuv420p planes.
+
+    Why this exists: at 768p on an 80 GiB card the DiT (45.2 GiB) can only stay resident if
+    the decode stops building full-canvas tensors it does not need. The ordinary path builds
+    two of them on rank 0 -- `torch.cat` over the blended chunks at 6 bytes per pixel (fp16
+    RGB, 1.99 GiB for 345 frames of 1344x768), then the pixel denormalisation at 12 bytes
+    per pixel (fp32, 3.98 GiB) -- and then converts the result to yuv420p, which is 1.5.
+    Since the conversion is per frame and the blend is temporally local, none of that has to
+    coexist: each chunk can become its final planes as it comes out of the assembly, and the
+    only full-length buffers are the planes themselves at 1.5 bytes per pixel.
+
+    Returns `(y, u, v)` uint8 on `device` on rank 0 -- the same tuple `rgb_to_yuv420p`
+    returns, so decode_and_save's encode path is unchanged -- and None elsewhere. Requires
+    the parallel decode; there is nothing to stream out of `vae.decode`.
+    """
+    if not can_decode_in_parallel(vae):
+        raise ValueError("decode_video_latents_yuv needs the chunked decode "
+                         "(tokens_chunk_size > 0 and token_drop > 0)")
+    latents_mean = torch.tensor(vae.config.latents_mean, device=device).view(1, -1, 1, 1, 1)
+    latents_std = torch.tensor(vae.config.latents_std, device=device).view(1, -1, 1, 1, 1)
+    scaled = latents * latents_std + latents_mean
+
+    pixel_mean = torch.tensor(PIXEL_MEAN, device=device).view(1, -1, 1, 1, 1)
+    pixel_std = torch.tensor(PIXEL_STD, device=device).view(1, -1, 1, 1, 1)
+
+    planes = None
+    if runtime.is_main:
+        # Sized up front from the chunk arithmetic rather than grown per chunk: the whole
+        # point is to hold exactly one full-length buffer per plane, and appending would hold
+        # two while it copied. `assembled_frame_count` is before the trailing trim, which is
+        # a slice at the end.
+        frames = assembled_frame_count(vae, latents.shape[2])
+        height = latents.shape[-2] * vae.spatial_compression_ratio
+        width = latents.shape[-1] * vae.spatial_compression_ratio
+        planes = (torch.empty((frames, height, width), dtype=torch.uint8, device=device),
+                  torch.empty((frames, height // 2, width // 2), dtype=torch.uint8, device=device),
+                  torch.empty((frames, height // 2, width // 2), dtype=torch.uint8, device=device))
+
+    def sink(offset, chunk):
+        # Exactly decode_video_latents' epilogue and decode_and_save's conversion, on
+        # `chunk.shape[2]` frames instead of all of them. Both are elementwise per frame
+        # (the chroma pool is 2x2 *spatial*), so the result is bit-identical -- asserted by
+        # scripts/decode_parity.py rather than argued here.
+        rgb = (chunk.float() * pixel_std + pixel_mean).clamp(0, 1)
+        y, u, v = rgb_to_yuv420p(rgb[0].permute(1, 0, 2, 3))
+        for plane, part in zip(planes, (y, u, v)):
+            plane[offset : offset + part.shape[0]] = part
+
+    with torch.autocast(device_type="cuda", dtype=torch.float16):
+        valid = decode_video_parallel(vae, scaled, runtime, sink=sink if runtime.is_main else _drop)
+    if not runtime.is_main:
+        return None
+    return tuple(plane[:valid] for plane in planes)
+
+
+def _drop(offset, chunk):
+    """A sink for the ranks that assemble nothing. decode_video_parallel only calls the sink
+    on rank 0, so this never runs; it exists so the argument is not None on those ranks,
+    which would silently select the `torch.cat` path if the guard above ever moved."""
+    raise AssertionError("only the main rank assembles")
+
