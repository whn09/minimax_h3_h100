+class _Geometry:
+    """`_decode`'s chunk arithmetic, derived once instead of inline.
+
+    Split out because a caller that wants to stream the assembly (`sink=` below) has to
+    size its own output buffer *before* the loop runs, and the only honest way to let it do
+    that is to hand it the same numbers the loop uses rather than a second derivation of
+    them.
+    """
+
+    def __init__(self, vae, num_latent_frames: int):
+        self.tokens_chunk = vae.tokens_chunk_size
+        self.token_drop = vae.config.token_drop
+        self.temporal_ratio = vae.temporal_compression_ratio
+        chunk_num_frames = self.tokens_chunk * self.temporal_ratio
+
+        num_tokens = num_latent_frames + self.token_drop
+        self.pad_tokens = (-num_tokens) % self.tokens_chunk
+        self.num_chunks = ((num_tokens + self.pad_tokens) // self.tokens_chunk
+                           - int(self.token_drop > 0))
+
+        self.chunk_num_frames = chunk_num_frames
+        self.main_frames = chunk_num_frames - vae.frame_pre_padding
+        self.overlap_frames = vae.frame_overlap if self.token_drop > 0 else 0
+
+        # What the assembly produces, and what of it was actually asked for. The trailing
+        # trim is _decode's: `pad_tokens` repeated latent frames produce pixel frames nobody
+        # requested. Verified against the released config -- clip_length 17, token_drop 3,
+        # 345 frames: 20 chunks x 17 main + a trailing 5 = 345, pad_frames 0.
+        self.assembled_frames = self.num_chunks * self.main_frames + self.overlap_frames
+        self.pad_frames = 0
+        if self.pad_tokens > 0:
+            intra_tail = vae.config.clip_length % self.temporal_ratio
+            self.pad_frames = sum(
+                intra_tail
+                if intra_tail and (num_latent_frames + k) % self.tokens_chunk == 0
+                else self.temporal_ratio
+                for k in range(self.pad_tokens)
+            )
+        self.valid_frames = self.assembled_frames - self.pad_frames
+
+
+def assembled_frame_count(vae, num_latent_frames: int) -> int:
+    """How many pixel frames `decode_video_parallel` will hand a sink, before the trailing
+    trim. A sink allocating its own output needs this; the trim is a slice afterwards."""
+    return _Geometry(vae, num_latent_frames).assembled_frames
+
